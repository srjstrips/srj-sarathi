# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://sarthi:sarthi_pass@localhost:5432/sarthi_hrms

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — CHANGE THESE IN PRODUCTION
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:8081

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sarthi-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-south-1
